# Create an EmailJS account at https://www.emailjs.com/
# Configure a Gmail/Outlook email service and a template in your EmailJS dashboard.
# Copy this file to .env.local, then insert your own values.
# These public browser-side IDs will be visible in the compiled app.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
